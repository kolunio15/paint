@page
@{
    ViewData["Title"] = "Banned";
    Layout = null;
    var reason = Request.Query["reason"].ToString();
    var untilStr = Request.Query["until"].ToString();
    DateTime? bannedUntil = null;
    if (!string.IsNullOrWhiteSpace(untilStr) && DateTime.TryParse(untilStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
        bannedUntil = parsed;
    var isPermanent = !bannedUntil.HasValue;
    var hoursLeft = bannedUntil.HasValue ? (int)Math.Ceiling((bannedUntil.Value - DateTime.UtcNow).TotalHours) : 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/css/style.css">
    <title>Access Denied</title>
</head>
<body>
    <main style="max-width: 420px; margin: 64px auto; text-align: center; padding: 0 10px;">
        <div class="win-window">
            <div class="gallery-titlebar">
                <div class="titlebar-title" style="--titlebar-icon:url('/icons/registration_no.ico')">Access Denied</div>
            </div>
            <div style="padding: 20px 24px; background: #ece9d8; text-align:left;">
                <div style="display:flex; gap:12px; align-items:flex-start; margin-bottom:16px;">
                    <img src="/icons/registration_no.ico" width="32" height="32" style="image-rendering:pixelated; flex-shrink:0;">
                    <p style="font-size:13px; margin:0;">
                        Your account has been <strong>@(isPermanent ? "permanently" : "temporarily")</strong> banned from this service.
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(reason))
                {
                    <div style="background:#fff0f0; border:1px solid #8b0000; padding:6px 10px; margin-bottom:12px; font-size:12px;">
                        <strong>Reason:</strong> @reason
                    </div>
                }

                @if (!isPermanent && bannedUntil.HasValue)
                {
                    <div style="background:#fff8e8; border:1px solid #8b4513; padding:6px 10px; margin-bottom:12px; font-size:12px;">
                        <strong>Expires:</strong> @bannedUntil.Value.ToString("yyyy-MM-dd HH:mm") UTC
                        @if (hoursLeft > 0)
                        {
                            <br /><span style="color:#666;">Access will be restored in approximately @hoursLeft hour@(hoursLeft != 1 ? "s" : "").</span>
                        }
                    </div>
                }

                @if (isPermanent)
                {
                    <p style="font-size:11px; color:#666; margin:0;">
                        This is a permanent ban. If you believe this is a mistake, contact the administrator.
                    </p>
                }
                else
                {
                    <p style="font-size:11px; color:#666; margin:0;">
                        If you believe this is a mistake, contact the administrator.
                    </p>
                }
            </div>
            <div class="gallery-statusbar">
                <span>@(isPermanent ? "Permanent ban" : "Temporary ban")</span>
            </div>
        </div>
    </main>
</body>
</html>
