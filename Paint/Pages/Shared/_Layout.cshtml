<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="~/icons/paint.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/style.css">

    @RenderSection("Style", required: false)

    <title>@ViewBag.Title</title>
</head>
<body>
    <nav>
        <ul>
            <li><a asp-page="/Index"><img src="~/icons/homepage.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Home</a></li>
            <li><a asp-page="/Rooms"><img src="~/icons/network_normal_two_pcs.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Rooms</a></li>
            <li><a asp-page="/Canvas" asp-route-roomId=@PaintDefaults.TestRoomId><img src="~/icons/paint.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Paint</a></li>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li><a asp-page="/Account"><img src="~/icons/address_book_user.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> @User.Identity.Name</a></li>
                @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
                {
                    <li><a asp-page="/Moderation/Index"><img src="~/icons/users_key.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Moderation</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-page="/Admin/Index"><img src="~/icons/users_key.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Admin</a></li>
                }
                <li>
                    <form method="post" asp-page="/Account" asp-page-handler="SignOut" style="display:inline;">
                        <button type="submit" class="nav-btn">
                            <img src="~/icons/key_padlock.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Log out
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li><a asp-page="/Auth/Login"><img src="~/icons/key_padlock.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Log in</a></li>
                <li><a asp-page="/Auth/Register"><img src="~/icons/address_book_user.ico" width="16" height="16" alt="" style="image-rendering:pixelated;vertical-align:middle"> Register</a></li>
            }
        </ul>
    </nav>
    <div>
        @RenderBody()
    </div>
</body>
</html>
