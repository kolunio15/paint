@page
@model Paint.Pages.Auth.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<main style="max-width: 420px; margin: 32px auto;">
    <h1>Change password</h1>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <p style="color: #006400;">@Model.StatusMessage</p>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" style="color: #8b0000;"></div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Input.CurrentPassword"></label><br />
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" style="color: #8b0000;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Input.NewPassword"></label><br />
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" style="color: #8b0000;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Input.ConfirmPassword"></label><br />
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" style="color: #8b0000;"></span>
        </div>

        <button type="submit">Change password</button>
    </form>
</main>
