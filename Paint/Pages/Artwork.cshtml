@page "{id:int}"
@model ArtworkModel
@{
    ViewData["Title"] = Model.Artwork.Title;
}

<main class="artwork-page">

    <div class="explorer-toolbar">
        <a asp-page="/Index" class="toolbar-btn">
            <div class="back-arrow"></div>
            Back
        </a>
        <div class="toolbar-separator"></div>
        <span class="toolbar-address">
            <img src="~/icons/directory_open.ico" width="16" height="16" alt="" style="image-rendering:pixelated;object-fit:contain">
            Gallery / @Model.Artwork.Title
        </span>
    </div>

    <div class="win-window">
        <div class="gallery-titlebar">
            <div class="titlebar-title" style="--titlebar-icon: url('/icons/paint_file.ico')">
                @Model.Artwork.Title
            </div>
            <div class="gallery-titlebar-buttons">
                <div class="titlebar-btn">_</div>
                <div class="titlebar-btn titlebar-btn-max"></div>
                <div class="titlebar-btn">✕</div>
            </div>
        </div>
        <div class="artwork-body">
            <img src="@Model.Artwork.ImageUrl" alt="@Model.Artwork.Title" class="artwork-img">
            <div class="artwork-info">
                <div class="artwork-info-row">
                    <span class="artwork-label">Title:</span>
                    <span>@Model.Artwork.Title</span>
                </div>
                @if (Model.Artwork.Users.Count > 0)
                {
                    <div class="artwork-info-row">
                        <span class="artwork-label">Author:</span>
                        <span>@Model.Artwork.Users[0].Name</span>
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("Moderator"))
                        {
                            <button class="mod-flag-btn" title="Report user"
                                    onclick="openReportModal(null, null, null, '@Model.Artwork.Users[0].Id')">⚑</button>
                        }
                    </div>
                }
                <div class="artwork-info-row">
                    <span class="artwork-label">Points:</span>
                    <span class="artwork-points" id="artworkScore">@Model.Artwork.Score</span>
                </div>
                <div class="artwork-info-row">
                    <span class="artwork-label">Comments:</span>
                    <span id="commentCount">@Model.Artwork.Comments.Count</span>
                </div>
                <div class="artwork-vote">
                    <button onclick="vote(1)">+ Vote Up</button>
                    <button onclick="vote(-1)">- Vote Down</button>
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                {
                    <div style="display:flex; align-items:center; gap:4px; margin-top:8px; padding-top:6px; border-top:1px solid #b0b0b0;">
                        @if (Model.Artwork.IsHidden)
                        {
                            <span class="mod-hidden-badge">● Hidden</span>
                            <button class="mod-bar-btn mod-bar-btn-ok" title="Unhide" onclick="moderateArtwork('unhide')">
                                <img src="/icons/file_eye.ico" width="14" height="14" style="image-rendering:pixelated; vertical-align:middle;"> Unhide
                            </button>
                        }
                        else
                        {
                            <button class="mod-bar-btn mod-bar-btn-danger" title="Hide" onclick="moderateArtwork('hide')">
                                <img src="/icons/msagent.ico" width="14" height="14" style="image-rendering:pixelated; vertical-align:middle;"> Hide
                            </button>
                        }
                        <button class="mod-bar-btn" title="Add to moderation queue" onclick="enqueueItem()">
                            <img src="/icons/message_tack.ico" width="14" height="14" style="image-rendering:pixelated; vertical-align:middle;"> Queue
                        </button>
                    </div>
                }
                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("Moderator"))
                {
                    <div style="margin-top:8px; padding-top:6px; border-top:1px solid #b0b0b0;">
                        <button class="mod-flag-btn" title="Report" onclick="openReportModal(artworkId, null, null)">⚑</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="win-window">
        <div class="gallery-titlebar">
            <div class="titlebar-title" style="--titlebar-icon: url('/icons/accessibility.ico')">
                Comments (<span id="commentCountTitle">@Model.Artwork.Comments.Count</span>)
            </div>
            <div class="gallery-titlebar-buttons">
                <div class="titlebar-btn">_</div>
                <div class="titlebar-btn titlebar-btn-max"></div>
                <div class="titlebar-btn">✕</div>
            </div>
        </div>
        <div class="comments-body">

            <div id="commentsList">
            @foreach (var comment in Model.Artwork.Comments)
            {
                <div class="comment" id="comment-@comment.User.Id-@comment.CreatedAt.Ticks">
                    <div class="comment-header">
                        <img src="~/icons/address_book_user.ico" width="16" height="16" alt="" style="image-rendering:pixelated;object-fit:contain">
                        <strong>@comment.User.Name</strong>
                        <span class="comment-date">@comment.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</span>
                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <button class="mod-bar-btn" style="margin-left:auto;" title="Add to moderation queue"
                                    onclick="enqueueItem()">
                                <img src="/icons/message_tack.ico" width="13" height="13" style="image-rendering:pixelated;">
                            </button>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="mod-flag-btn" style="margin-left:auto;" title="Report"
                                    onclick="openReportModal(artworkId, null, null)">⚑</button>
                        }
                    </div>
                    <div class="comment-text">@comment.Content</div>
                </div>
            }
            @if (!Model.Artwork.Comments.Any())
            {
                <div style="padding: 12px; color: #808080; text-align: center;" id="noComments">No comments yet. Be the first!</div>
            }
            </div>

            <div class="comment-form">
                <div class="win-window-inset">
                    <label for="comment-input">Add comment:</label>
                    <textarea id="comment-input" rows="3" placeholder="Write your comment here..."></textarea>
                </div>
                <button class="comment-submit" onclick="submitComment()">Post Comment</button>
            </div>
        </div>

        <div class="gallery-statusbar">
            <span id="statusCommentCount">@Model.Artwork.Comments.Count comment(s)</span>
            <span>Ready</span>
        </div>
    </div>

</main>

@Html.AntiForgeryToken()
<script>
const artworkId = @Model.Artwork.Id;

function antiforgeryHeaders() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const headers = { 'Content-Type': 'application/json' };
    if (token) headers['RequestVerificationToken'] = token;
    return headers;
}

async function moderateArtwork(action) {
    const res = await fetch(`/api/moderation/${action}`, {
        method: 'POST',
        headers: antiforgeryHeaders(),
        body: JSON.stringify({ artworkId })
    });
    if (res.ok) location.reload();
}

async function enqueueItem() {
    await fetch('/api/moderation/enqueue', {
        method: 'POST',
        headers: antiforgeryHeaders(),
        body: JSON.stringify({ targetArtworkId: artworkId })
    });
}

let _reportTarget = {};

function openReportModal(aId, cId, rId, uId = null) {
    _reportTarget = { artworkId: aId, commentId: cId, roomId: rId, userId: uId };
    document.getElementById('reportReasonInput').value = '';
    document.getElementById('reportOverlay').style.display = 'flex';
    setTimeout(() => document.getElementById('reportReasonInput').focus(), 50);
}

function closeReportModal() {
    document.getElementById('reportOverlay').style.display = 'none';
}

async function submitReport() {
    const reason = document.getElementById('reportReasonInput').value.trim() || null;
    await fetch('/api/moderation/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            targetArtworkId: _reportTarget.artworkId ?? null,
            targetCommentId: _reportTarget.commentId ?? null,
            targetRoomId: _reportTarget.roomId ?? null,
            targetUserId: _reportTarget.userId ?? null,
            reason
        })
    });
    closeReportModal();
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeReportModal(); });


async function vote(value) {
    const res = await fetch(`/api/artworks/${artworkId}/vote`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vote: value })
    });
    if (res.status === 204) {
        const detailRes = await fetch(`/api/artworks/${artworkId}`);
        if (detailRes.ok) {
            const data = await detailRes.json();
            const scoreEl = document.getElementById('artworkScore');
            if (scoreEl) scoreEl.textContent = data.score;
        }
    } else if (res.status === 401) {
        window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
    }
}

async function submitComment() {
    const textarea = document.getElementById('comment-input');
    const message = textarea.value.trim();
    if (!message) return;

    const res = await fetch(`/api/artworks/${artworkId}/comments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message })
    });
    if (res.status === 201) {
        const comment = await res.json();
        textarea.value = '';

        const noComments = document.getElementById('noComments');
        if (noComments) noComments.remove();

        const list = document.getElementById('commentsList');
        const div = document.createElement('div');
        div.className = 'comment';
        const date = new Date(comment.createdAt);
        const dateStr = date.toLocaleDateString('en-US') + ' ' + date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        div.innerHTML = `
            <div class="comment-header">
                <img src="/icons/address_book_user.ico" width="16" height="16" style="image-rendering:pixelated;object-fit:contain">
                <strong>${comment.user.name}</strong>
                <span class="comment-date">${dateStr}</span>
            </div>
            <div class="comment-text">${escapeHtml(comment.content)}</div>`;
        list.appendChild(div);

        const count = list.querySelectorAll('.comment').length;
        ['commentCount', 'commentCountTitle'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = count;
        });
        const status = document.getElementById('statusCommentCount');
        if (status) status.textContent = count + ' comment(s)';
    } else if (res.status === 401) {
        window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
    }
}

function escapeHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>

<div id="reportOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.3); z-index:1000; align-items:center; justify-content:center;">
    <div class="win-window" style="width:320px; box-shadow:4px 4px 0 #000;">
        <div class="gallery-titlebar">
            <div class="titlebar-title" style="--titlebar-icon:url('/icons/msg_warning.ico')">Report Content</div>
            <div class="gallery-titlebar-buttons">
                <div class="titlebar-btn" onclick="closeReportModal()">✕</div>
            </div>
        </div>
        <div style="padding:12px 16px; background:#ece9d8;">
            <p style="margin:0 0 8px; font-size:12px;">Describe the issue (optional):</p>
            <input id="reportReasonInput" type="text" class="win-window-inset"
                   style="width:100%; padding:2px 4px; font-size:12px; font-family:inherit;"
                   placeholder="e.g. inappropriate content"
                   onkeydown="if(event.key==='Enter') submitReport()" />
        </div>
        <div style="padding:6px 16px 10px; background:#ece9d8; display:flex; justify-content:flex-end; gap:6px; border-top:1px solid #808080;">
            <button class="comment-submit" onclick="submitReport()">Report</button>
            <button class="toolbar-btn" style="justify-content:center; min-width:64px;" onclick="closeReportModal()">Cancel</button>
        </div>
    </div>
</div>
